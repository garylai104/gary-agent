# 複製此檔為 gary-agent/.env 後填入實際值（實際值向團隊索取，勿提交進版控）
JIRA_BASE_URL=https://xxx.atlassian.net
JIRA_EMAIL=your@example.com
JIRA_API_TOKEN=
TESTRAIL_BASE_URL=https://xxx.testrail.io
TESTRAIL_EMAIL=your@example.com
TESTRAIL_API_KEY=
GITHUB_TOKEN=
LOCAL_REPO_ROOT=
JENKINS_USER=

# Jenkins 主機：每台一組，{ip} 為 IP 末碼（如 JENKINS_URL_85）
JENKINS_URL_{ip}=http://x.x.x.{ip}:8080
JENKINS_LABEL_{ip}=
JENKINS_TOKEN_{ip}=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_REPORT_BUCKET=
AI_PERF_TOKEN=

# skills/ 加解密金鑰（scripts/skills_crypt.py 使用）
SKILLS_CRYPT_KEY=
